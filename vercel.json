{
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "functions": {
    "app/api/agent/deutbot/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/all-crawl",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/all-process",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/daily-vrief",
      "schedule": "1 1 * * *"
    },
    {
      "path": "/api/cron/trend-crawl",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-gpr",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/badak-expire-wants",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/newsletter/cron/dispatch",
      "schedule": "*/10 * * * *"
    }
  ]
}
